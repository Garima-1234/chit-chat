{
  "name": "nodeserver",
  "version": "1.0.0",
  "description": "this is a nodeserver for my chat app",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node index.js",
    "dev": "nodemon --watch index.js --watch package.json --ext js,json --ignore data/** index.js"
  },
  "nodemonConfig": {
    "ignore": [
      "data/store.json",
      "data/*.json",
      "node_modules/**"
    ]
  },
  "author": "garima",
  "license": "ISC",
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
